# ==================================================
# VisionPR Configuration
# ==================================================

# auto = automatically choose CrewAI if API keys exist,
# otherwise use offline heuristic agents
VISIONPR_MODE=auto

# Active LLM provider
# Options: gemini | groq 
VISIONPR_LLM_PROVIDER=
VISIONPR_LLM_MODEL=

# Configure Gemini or Groq for online CrewAI mode
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
MAX_VISION_FRAMES=3
MAX_VISION_IMAGE_DIMENSION=640

# Real integration tests remain disabled by default
RUN_LLM_TESTS=0

# GitHub
# The credential must be able to push directly or create/reuse a fork for PRs.
GITHUB_TOKEN=

# GitHub OAuth app for the web interface. The callback URL in GitHub must be:
# http://127.0.0.1:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VISIONPR_SESSION_SECRET=replace-with-a-long-random-value
VISIONPR_FRONTEND_URL=http://127.0.0.1:5173
VISIONPR_BACKEND_URL=http://127.0.0.1:8000
VISIONPR_COOKIE_SECURE=0
VISIONPR_DEMO_MODE=1

# Default Models
GEMINI_MODEL=gemini-2.5-pro
GROQ_MODEL=llama-3.3-70b-versatile

# Provider-neutral prompt budgets. Lower these for accounts with small TPM limits.
VISIONPR_AGENT_CONTEXT_MAX_CHARS=16000
VISIONPR_REVIEW_DIFF_MAX_CHARS=8000
VISIONPR_TOOL_READ_MAX_CHARS=12000
